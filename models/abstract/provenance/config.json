  "objective_source": "class Distillation(StyleLoss):\n def terms(self,y,x,t,fx):\n  v=super().forward(y,x,fx)\n  with torch.no_grad():ft=self.net(t)\n  fy=self.net(y)\n  v['teacher_perceptual']=sum(F.mse_loss(a,b)/b.square().mean().clamp_min(1e-5) for a,b in zip(fy[1:3],ft[1:3]))/2\n  v['pixel']=F.l1_loss(y,t)\n  v['coarse_pixel']=F.l1_loss(F.avg_pool2d(y,4),F.avg_pool2d(t,4))\n  ey=[(y[:,:,:,1:]-y[:,:,:,:-1]).abs(),(y[:,:,1:,:]-y[:,:,:-1,:]).abs()]\n  et=[(t[:,:,:,1:]-t[:,:,:,:-1]).abs(),(t[:,:,1:,:]-t[:,:,:-1,:]).abs()]\n  v['texture_energy']=sum(F.l1_loss(F.avg_pool2d(a,7,1),F.avg_pool2d(b,7,1)) for a,b in zip(ey,et))\n  hy=(y-blur(y)).square().mean((1,2,3));ht=(t-blur(t)).square().mean((1,2,3))\n  v['hf_excess']=F.relu(hy-ht*1.05).mean()\n  return v\n def objective(self,v):\n  scale=getattr(self,'style_scale',1.)\n  return scale*(2*v['gram']+v['coarse']+v['patch'])+.6*v['content']+.2*v['layout']+.25*v['outline']+12*v['palette']+4*v['pixel']+1.5*v['coarse_pixel']+v['teacher_perceptual']+.7*v['texture_energy']+85*v['hf_excess']+.2*v['tv']+40*v['checker']\n",
